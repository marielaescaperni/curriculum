# Set these privately in Vercel > Project > Settings > Environment Variables.
# For local testing copy to .env.local and fill in your own values.
# Get your access key after verifying the receiving email at https://web3forms.com/
WEB3FORMS_ACCESS_KEY=

# Optional: Cloudflare Web Analytics site token (public, 32 hex characters).
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Optional: Google Search Console HTML-tag verification 'content' value.
# Set only the token, not the entire <meta> tag.
PUBLIC_GOOGLE_SITE_VERIFICATION=
